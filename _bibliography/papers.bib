@thesis{woessner_thesis,
      abbr={EPFL},
      title={THESE : S(P)DEs and the study of random fields},
      author={Guillaume Woessner},
      year={2025},
      preview={epfl.png},
      url={https://infoscience.epfl.ch/entities/publication/6016df58-4559-4d02-bcc4-54863feafb0a},
      doi={10.5075/epfl-thesis-11239},
      abstract={Cette thèse présente trois contributions dans le domaine des équations fonctionnelles stochastiques et des champs gaussiens. Dans le premier travail, nous établissons une relation de type Fokker- Planck entre une certaine classe d’EDS de McKean-Vlasov et le modèle d’EDP de Keller-Segel. Dans la deuxième contribution, nous montrons que la dimension de Hausdorff des zéros du Brownian sheet est préservée par toutes les projections linéaires si et seulement si une certaine condition sur les dimensions est satisfaite. Enfin, dans le troisième projet, nous prouvons un nouveau théorème de caractérisation pour le Champ Libre Gaussien en développant une approche utilisant une dynamique de rééchantillonnage. Cette approche nous permet de généraliser les résultats précédents et s’applique à la classe plus générale des champs gaussiens fractionnaires.},
}

@article{aru2024martingaletypecharacterisationgaussianfree,
      abbr={Arxiv},
      title={A martingale-type of characterisation of the Gaussian free field and fractional Gaussian free fields}, 
      author={Juhan Aru \& Guillaume Woessner},
      eprint={2407.16261},
      year={2024},
      archivePrefix={arXiv},
      primaryClass={math.PR},
      url={https://arxiv.org/abs/2407.16261},
      doi={10.48550/arXiv.2407.16261},
      preview={fgf.png},
      abstract={We establish a martingale-type characterisations for the continuum Gaussian free field (GFF) and for fractional Gaussian free fields (FGFs), using their connection to the stochastic heat equation and to fractional stochastic heat equations. The main theorem on the GFF generalizes previous results of similar flavour and the characterisation theorems on the FGFs are new. The proof strategy is to link the resampling dynamics coming from a martingale-type of decomposition property to the stationary dynamics of the desired field, i.e. to the (fractional) stochastic heat equation.},
}

@article{Chen2025,
abbr={Springer},
author = {Keming Chen \& Guillaume Woessner}, 
title = {Zeros of the Brownian Sheet},
journal = {Journal of Theoretical Probability},
year={2025},
abstract = {In this work, we firstly answer to a question raised by Khoshnevisan by proving that almost surely there is no projection of big enough rank changing the Hausdorff dimension of the zeros of the Brownian sheet. Secondly, we prove that almost surely for every projection whose rank is not matching the aforementioned condition, the projection of the zero set is the entirety of the projective space.},
URL = {https://doi.org/10.1007/s10959-024-01399-1},
doi = {10.1007/s10959-024-01399-1},
preview={Brownian_surface.png},
}


@article{Tomašević03072024,
abbr={Taylor and Francis},
author = {Milica Tomašević \& Guillaume Woessner},
title = {On a multi-dimensional McKean-Vlasov SDE with memorial and singular interaction associated to the parabolic-parabolic Keller-Segel model},
journal = {Stochastic Analysis and Applications},
year={2024},
volume = {42},
number = {4},
pages = {767--796},
publisher = {Taylor \& Francis},
doi = {10.1080/07362994.2024.2381768},
URL = {https://doi.org/10.1080/07362994.2024.2381768},
eprint = {https://doi.org/10.1080/07362994.2024.2381768},
preview={blob.png},
abstract = { In this work, we first prove the well-posedness of the non-linear martingale problem related to a McKean-Vlasov stochastic differential equation with singular interaction kernel in dimension d≥3. The particularity of our setting is that the McKean-Vlasov process we study interacts at each time with all its past time marginal laws by means of a singular space-time kernel. Second, we prove that our stochastic process is a probabilistic interpretation for the parabolic-parabolic Keller-Segel system in ℝd. We thus obtain a well-posedness result to the latter under explicit smallness condition on the parameters of the model. }
}

